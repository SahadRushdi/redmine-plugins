<style type="text/css">
  h1 { font-size: 20px; color: #333; }
  h2 { font-size: 16px; margin-top: 20px; border-bottom: 1px solid #ccc; padding-bottom: 5px; }
  table.issues { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
  table.issues th, table.issues td { border: 1px solid #ddd; padding: 8px; text-align: left; font-size: 10px; }
  .report-meta { font-style: italic; font-size: 12px; margin-bottom: 20px; }
</style>

<h1>All Active Projects Status Report</h1>

<div class="report-meta">
  Report Generated by: <%= User.current.name %> on <%= format_date(Date.today) %>
</div>

<% @active_projects.each do |project| %>
  <h2><%= project.name %> (<%= project.identifier %>)</h2>
  <div class="report-meta">
    Project Status: <%= project.status_name %> | Created: <%= format_date(project.created_on) %>
  </div>

  <% if project.issues.any? %>
    <table class="issues">
      <thead>
        <tr>
          <th width="5%">ID</th>
          <th width="45%">Subject</th>
          <th width="15%">Tracker</th>
          <th width="15%">Status</th>
          <th width="20%">Assigned To</th>
        </tr>
      </thead>
      <tbody>
        <% project.issues.each do |issue| %>
          <tr>
            <td><%= issue.id %></td>
            <td><%= issue.subject %></td>
            <td><%= issue.tracker.name %></td>
            <td><%= issue.status.name %></td>
            <td><%= issue.assigned_to ? issue.assigned_to.name : '-' %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No **open** issues found for this project.</p>
  <% end %>
<% end %>
